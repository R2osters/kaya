# lucide-react-native@0.475.0 (the version @kaya/ui shipped with, already
# threaded through KayaButton/KayaAvatar/RatingStars/StatusPill and covered
# by its 187 tests) declares a peerDependencies range on react that stops at
# ^18.0.0, while this monorepo is on react@19.1.0. lucide-react-native@1.x
# does support React 19, but it also switched to an ESM-only build
# (dist/esm/*.mjs with no CJS entry point) that Jest's default transform
# cannot parse without extra transformIgnorePatterns wiring across every
# package that imports it -- a bigger, separately-reviewable change than
# resolving an install-time peer check npm is simply being conservative
# about. React 19 is a drop-in replacement for lucide's actual usage
# (forwardRef + SVG props); the declared peer range just hasn't caught up.
#
# npm ci ignores peer conflicts entirely (it installs exactly what the
# lockfile already resolved), which is why that path already worked. This
# setting is what makes a *fresh* `npm install` behave the same way, instead
# of failing with ERESOLVE the moment someone re-primes node_modules.
#
# This alone does not stop npm from nesting a second, divergent copy of
# react/react-native per workspace (each package.json pins an exact
# "19.1.0"/"0.81.5", and without a hard pin at the root npm's resolver can
# still hoist a *different*, newer version to node_modules/react that
# satisfies looser ranges elsewhere in the graph -- e.g. expo-router's peer
# "react": "*" -- which silently breaks React's module-singleton invariant
# ("Invalid hook call") the moment an app renders a @kaya/ui component). The
# root package.json's "overrides" for react and react-native force a single
# resolved version everywhere, which is the piece that actually fixes that.
legacy-peer-deps=true
