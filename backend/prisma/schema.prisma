// Kaya delivery platform - Prisma schema (Milestone 1).
// Mirrors docs/Architecture_Livraison_MultiPays.md section 2, plus the auth
// support tables (OtpCode, RefreshToken, Notification).
// Conventions: snake_case columns/tables via @map/@@map; money is always Decimal.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS is enabled by the migration engine (CREATE EXTENSION postgis).
  // The functional GiST geography index is added by prisma/postgis.sql.
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  client
  livreur
  both
  admin // Deviation from doc (role = client|livreur|both): admin added for §3.9 admin auth.
}

enum CountryCode {
  GHA
  TGO
  BEN
}

enum VehicleType {
  moto
  voiture
  camionnette
}

enum OrderStatus {
  draft
  published
  offers_received
  accepted
  driver_en_route
  picked_up
  in_transit
  delivered
  cancelled
  disputed
}

enum OfferStatus {
  pending
  accepted
  rejected
  expired
}

enum DeliveryStatus {
  in_progress
  completed
  cancelled
  disputed
}

enum ClientPaymentStatus {
  pending
  escrow_held
  released
  refunded
}

enum DriverPayoutStatus {
  pending
  processed
  withdrawn
}

enum RatingRole {
  client
  livreur
}

enum TransactionType {
  payment_in
  escrow_release
  commission
  litigation_fee
  driver_payout
  withdrawal
  refund
  adjustment
}

enum TransactionStatus {
  pending
  completed
  failed
  reversed
}

enum Currency {
  GHS
  XOF
}

enum PaymentMethod {
  momo
  card
  bank_transfer
  cash
}

enum WithdrawalMethod {
  momo
  bank_transfer
}

enum WithdrawalStatus {
  pending
  processing
  completed
  failed
}

enum OtpPurpose {
  registration
  login
  password_reset
  phone_verification
}

enum NotificationType {
  order
  offer
  delivery
  payment
  withdrawal
  rating
  system
}

// ---------------------------------------------------------------------------
// Core entities
// ---------------------------------------------------------------------------

model User {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  phone        String      @unique
  passwordHash String      @map("password_hash")
  fullName     String      @map("full_name")
  age          Int?
  idCardPhoto  String?     @map("id_card_photo")
  profilePhoto String?     @map("profile_photo")
  role         Role
  countryCode  CountryCode @map("country_code")
  city         String?
  isVerified   Boolean     @default(false) @map("is_verified")
  verifiedAt   DateTime?   @map("verified_at")
  verifiedById String?     @map("verified_by_id") @db.Uuid
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  // Driver-specific fields (NULL when role = client)
  driverLicenseNumber String?      @map("driver_license_number")
  driverLicensePhoto  String?      @map("driver_license_photo")
  driverQrCode        String?      @map("driver_qr_code")
  vehicleType         VehicleType? @map("vehicle_type")
  vehicleRegistration String?      @map("vehicle_registration")
  vehiclePhoto        String?      @map("vehicle_photo")
  locationLat         Decimal?     @map("location_lat") @db.Decimal(10, 8)
  locationLng         Decimal?     @map("location_lng") @db.Decimal(11, 8)
  locationUpdatedAt   DateTime?    @map("location_updated_at")
  isOnline            Boolean      @default(false) @map("is_online")
  ratingDriver        Decimal      @default(5.0) @map("rating_driver") @db.Decimal(2, 1)
  ratingClient        Decimal      @default(5.0) @map("rating_client") @db.Decimal(2, 1)
  totalDeliveries     Int          @default(0) @map("total_deliveries")
  dailyDeliveries     Int          @default(0) @map("daily_deliveries")
  balance             Decimal      @default(0) @db.Decimal(12, 2)
  fcmToken            String?      @map("fcm_token")

  // Relations
  orders               Order[]          @relation("ClientOrders")
  offers               Offer[]
  deliveries           Delivery[]       @relation("DriverDeliveries")
  ratingsGiven         Rating[]         @relation("RatingsFrom")
  ratingsReceived      Rating[]         @relation("RatingsTo")
  messagesSent         Message[]        @relation("MessagesSent")
  messagesReceived     Message[]        @relation("MessagesReceived")
  transactions         Transaction[]
  withdrawals          Withdrawal[]     @relation("DriverWithdrawals")
  withdrawalsProcessed Withdrawal[]     @relation("WithdrawalsProcessedBy")
  refreshTokens        RefreshToken[]
  notifications        Notification[]
  litigationEntries    LitigationFund[] @relation("LitigationCreatedBy")

  @@index([countryCode])
  @@index([role])
  @@map("users")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  clientId          String      @map("client_id") @db.Uuid
  client            User        @relation("ClientOrders", fields: [clientId], references: [id])
  pickupAddress     String      @map("pickup_address")
  pickupLat         Decimal     @map("pickup_lat") @db.Decimal(10, 8)
  pickupLng         Decimal     @map("pickup_lng") @db.Decimal(11, 8)
  deliveryAddress   String      @map("delivery_address")
  deliveryLat       Decimal     @map("delivery_lat") @db.Decimal(10, 8)
  deliveryLng       Decimal     @map("delivery_lng") @db.Decimal(11, 8)
  description       String?
  packagePhoto      String?     @map("package_photo")
  weightKg          Decimal?    @map("weight_kg") @db.Decimal(6, 2)
  dimensions        String?
  scheduledTime     DateTime?   @map("scheduled_time")
  publishedAt       DateTime?   @map("published_at")
  status            OrderStatus @default(draft)
  minPriceSuggested Decimal?    @map("min_price_suggested") @db.Decimal(10, 2)
  distanceKm        Decimal?    @map("distance_km") @db.Decimal(6, 2)
  acceptedOfferId   String?     @unique @map("accepted_offer_id") @db.Uuid
  acceptedOffer     Offer?      @relation("AcceptedOffer", fields: [acceptedOfferId], references: [id])
  remindedAt        DateTime?   @map("reminded_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  cancelReason      String?     @map("cancel_reason")

  offers   Offer[]   @relation("OrderOffers")
  delivery Delivery?

  @@index([clientId])
  @@index([status])
  @@map("orders")
}

model Offer {
  id            String      @id @default(uuid()) @db.Uuid
  orderId       String      @map("order_id") @db.Uuid
  order         Order       @relation("OrderOffers", fields: [orderId], references: [id])
  livreurId     String      @map("livreur_id") @db.Uuid
  livreur       User        @relation(fields: [livreurId], references: [id])
  proposedPrice Decimal     @map("proposed_price") @db.Decimal(10, 2)
  minPrice      Decimal     @map("min_price") @db.Decimal(10, 2)
  status        OfferStatus @default(pending)
  createdAt     DateTime    @default(now()) @map("created_at")
  expiresAt     DateTime?   @map("expires_at")

  acceptedForOrder Order? @relation("AcceptedOffer")

  @@unique([orderId, livreurId])
  @@index([orderId])
  @@index([livreurId])
  @@map("offers")
}

model Delivery {
  id                  String              @id @default(uuid()) @db.Uuid
  orderId             String              @unique @map("order_id") @db.Uuid
  order               Order               @relation(fields: [orderId], references: [id])
  livreurId           String              @map("livreur_id") @db.Uuid
  livreur             User                @relation("DriverDeliveries", fields: [livreurId], references: [id])
  pickupPhoto         String?             @map("pickup_photo")
  pickupPhotoTakenAt  DateTime?           @map("pickup_photo_taken_at")
  deliveryPhoto       String?             @map("delivery_photo")
  deliveryConfirmedAt DateTime?           @map("delivery_confirmed_at")
  startTime           DateTime?           @map("start_time")
  pickupTime          DateTime?           @map("pickup_time")
  deliveryTime        DateTime?           @map("delivery_time")
  distanceKm          Decimal?            @map("distance_km") @db.Decimal(6, 2)
  basePrice           Decimal?            @map("base_price") @db.Decimal(10, 2)
  commissionRate      Decimal?            @map("commission_rate") @db.Decimal(4, 2)
  commissionAmount    Decimal?            @map("commission_amount") @db.Decimal(10, 2)
  litigationFee       Decimal             @default(1.00) @map("litigation_fee") @db.Decimal(6, 2)
  netEarnings         Decimal?            @map("net_earnings") @db.Decimal(10, 2)
  clientPaymentStatus ClientPaymentStatus @default(pending) @map("client_payment_status")
  driverPayoutStatus  DriverPayoutStatus  @default(pending) @map("driver_payout_status")
  status              DeliveryStatus      @default(in_progress)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  ratings      Rating[]
  messages     Message[]
  transactions Transaction[]

  @@index([livreurId])
  @@map("deliveries")
}

model Rating {
  id         String     @id @default(uuid()) @db.Uuid
  deliveryId String     @map("delivery_id") @db.Uuid
  delivery   Delivery   @relation(fields: [deliveryId], references: [id])
  fromUserId String     @map("from_user_id") @db.Uuid
  fromUser   User       @relation("RatingsFrom", fields: [fromUserId], references: [id])
  toUserId   String     @map("to_user_id") @db.Uuid
  toUser     User       @relation("RatingsTo", fields: [toUserId], references: [id])
  roleType   RatingRole @map("role_type")
  score      Int
  comment    String?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@unique([deliveryId, fromUserId])
  @@index([toUserId])
  @@map("ratings")
}

model Message {
  id          String    @id @default(uuid()) @db.Uuid
  deliveryId  String    @map("delivery_id") @db.Uuid
  delivery    Delivery  @relation(fields: [deliveryId], references: [id])
  senderId    String    @map("sender_id") @db.Uuid
  sender      User      @relation("MessagesSent", fields: [senderId], references: [id])
  receiverId  String    @map("receiver_id") @db.Uuid
  receiver    User      @relation("MessagesReceived", fields: [receiverId], references: [id])
  messageText String?   @map("message_text")
  imageUrl    String?   @map("image_url")
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([deliveryId])
  @@map("messages")
}

model Transaction {
  id            String            @id @default(uuid()) @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  user          User              @relation(fields: [userId], references: [id])
  deliveryId    String?           @map("delivery_id") @db.Uuid
  delivery      Delivery?         @relation(fields: [deliveryId], references: [id])
  type          TransactionType
  amount        Decimal           @db.Decimal(12, 2)
  currency      Currency          @default(GHS)
  status        TransactionStatus @default(pending)
  // Gateway reference. Unique so webhook replays are idempotent (many internal
  // ledger rows carry NULL, which Postgres treats as non-conflicting).
  reference     String?           @unique
  paymentMethod PaymentMethod?    @map("payment_method")
  metadata      Json?
  createdAt     DateTime          @default(now()) @map("created_at")
  processedAt   DateTime?         @map("processed_at")

  litigationEntries LitigationFund[]

  @@index([userId])
  @@index([deliveryId])
  @@index([type])
  @@map("transactions")
}

model Withdrawal {
  id              String           @id @default(uuid()) @db.Uuid
  livreurId       String           @map("livreur_id") @db.Uuid
  livreur         User             @relation("DriverWithdrawals", fields: [livreurId], references: [id])
  amount          Decimal          @db.Decimal(12, 2)
  method          WithdrawalMethod
  accountDetails  Json             @map("account_details")
  status          WithdrawalStatus @default(pending)
  feeAmount       Decimal          @default(0) @map("fee_amount") @db.Decimal(8, 2)
  requestedAt     DateTime         @default(now()) @map("requested_at")
  processedAt     DateTime?        @map("processed_at")
  processedBy     String?          @map("processed_by") @db.Uuid
  processedByUser User?            @relation("WithdrawalsProcessedBy", fields: [processedBy], references: [id])
  rejectionReason String?          @map("rejection_reason")

  @@index([livreurId])
  @@map("withdrawals")
}

model CountryConfig {
  id                        String      @id @default(uuid()) @db.Uuid
  countryCode               CountryCode @unique @map("country_code")
  countryName               String      @map("country_name")
  currencyCode              Currency    @map("currency_code")
  currencySymbol            String      @map("currency_symbol")
  pricePerKm                Decimal     @default(1.00) @map("price_per_km") @db.Decimal(6, 2)
  basePickupFee             Decimal     @default(2.00) @map("base_pickup_fee") @db.Decimal(8, 2)
  commissionTier1           Decimal     @default(0.20) @map("commission_tier1") @db.Decimal(4, 2)
  commissionTier2           Decimal     @default(0.15) @map("commission_tier2") @db.Decimal(4, 2)
  commissionTier3           Decimal     @default(0.12) @map("commission_tier3") @db.Decimal(4, 2)
  commissionTier4           Decimal     @default(0.09) @map("commission_tier4") @db.Decimal(4, 2)
  litigationFee             Decimal     @default(1.00) @map("litigation_fee") @db.Decimal(6, 2)
  searchRadiusKm            Int         @default(5) @map("search_radius_km")
  scheduledPublishBufferMin Int         @default(30) @map("scheduled_publish_buffer_min")
  reminderBeforeMin         Int         @default(60) @map("reminder_before_min")
  withdrawalMethods         Json        @map("withdrawal_methods")
  momoProviders             Json?       @map("momo_providers")
  isActive                  Boolean     @default(true) @map("is_active")
  createdAt                 DateTime    @default(now()) @map("created_at")
  updatedAt                 DateTime    @updatedAt @map("updated_at")

  @@map("country_configs")
}

model LitigationFund {
  id            String      @id @default(uuid()) @db.Uuid
  transactionId String      @map("transaction_id") @db.Uuid
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  description   String
  balanceAfter  Decimal     @map("balance_after") @db.Decimal(12, 2)
  createdAt     DateTime    @default(now()) @map("created_at")
  createdBy     String?     @map("created_by") @db.Uuid
  createdByUser User?       @relation("LitigationCreatedBy", fields: [createdBy], references: [id])

  @@map("litigation_fund")
}

// ---------------------------------------------------------------------------
// Auth support tables (additions beyond the architecture doc)
// ---------------------------------------------------------------------------

model OtpCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String?
  email      String?
  codeHash   String     @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime   @map("expires_at")
  consumedAt DateTime?  @map("consumed_at")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([phone])
  @@index([email])
  @@map("otp_codes")
}

model RefreshToken {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  user         User          @relation(fields: [userId], references: [id])
  tokenHash    String        @map("token_hash")
  expiresAt    DateTime      @map("expires_at")
  revokedAt    DateTime?     @map("revoked_at")
  replacedById String?       @unique @map("replaced_by_id") @db.Uuid
  replacedBy   RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces     RefreshToken? @relation("TokenRotation")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  target    String?
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}
