# ===========================================================================
# Kaya API - environment template. Copy to `.env` and adjust for your machine.
# NEVER commit a real .env. All values below are safe dev defaults.
# ===========================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Neutral working name; no hard-coded branding anywhere else in the codebase.
APP_NAME=Kaya

# --- Database (PostgreSQL + PostGIS) --------------------------------------
# Host "postgres" works inside docker-compose; use "localhost" when running the
# API on the host against the composed database.
DATABASE_URL=postgresql://kaya:kaya@localhost:5432/kaya?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- JWT (RS256) -----------------------------------------------------------
# Either a path to a PEM file OR an inline PEM string (must contain "BEGIN").
# Generate a dev keypair with: npm run generate:keys
JWT_PRIVATE_KEY=./keys/jwt-private.pem
JWT_PUBLIC_KEY=./keys/jwt-public.pem
# Access token lifetime (seconds) - 15 minutes.
JWT_ACCESS_TTL=900
# Refresh token lifetime (seconds) - 7 days.
JWT_REFRESH_TTL=604800
JWT_ISSUER=kaya-api
JWT_AUDIENCE=kaya-app

# --- CORS ------------------------------------------------------------------
# Comma-separated origin whitelist. Empty in dev allows the Swagger UI origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Rate limiting ---------------------------------------------------------
# 100 requests / 60s per IP (global throttler).
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# --- Object storage (S3-compatible / MinIO in dev) ------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=kaya-minio
S3_SECRET_KEY=kaya-minio-secret
S3_BUCKET=kaya-uploads
# MinIO requires path-style addressing.
S3_FORCE_PATH_STYLE=true
# Public base URL used to build returned file URLs (MinIO console/gateway).
S3_PUBLIC_URL=http://localhost:9000/kaya-uploads
# Max upload size in bytes (5 MB).
UPLOAD_MAX_BYTES=5242880

# --- Bcrypt ----------------------------------------------------------------
BCRYPT_ROUNDS=12

# --- Maps / distance (M2) --------------------------------------------------
# Every delivery is priced as distance_km * price_per_km + base_pickup_fee, so
# this is a pricing decision, not an infrastructure one.
#   haversine (default) - straight line x 1.3, no key. Measured against real
#                         routes it is wrong by up to 15%, and the error changes
#                         sign, so no better constant fixes it.
#   osrm                - real road distance. Falls back to haversine on any
#                         failure, so a routing outage degrades a quote's
#                         accuracy rather than blocking an order.
#   google              - Distance Matrix, needs a key and a billing account.
MAPS_PROVIDER=haversine
# Public demo server: keyless, fine for dev, no SLA and not covered for
# commercial use. Production points this at a self-hosted OSRM container built
# from a Ghana/Togo/Benin OSM extract.
OSRM_BASE_URL=https://router.project-osrm.org
GOOGLE_MAPS_API_KEY=

# --- Geocoding (address type-ahead) ----------------------------------------
# Backs GET /geocoding/search, which the create-order and address-search
# screens need: a user types an address and the price needs two GeoPoints.
#   photon (default) - keyless OSM geocoder built for type-ahead. Degrades to
#                      the static landmark list when unreachable.
#   static           - the offline landmark list only (tests, air-gapped demos).
# Nominatim is deliberately absent: its usage policy forbids auto-complete
# queries, which is the only thing this endpoint does.
GEOCODING_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io

# --- Phone / identity verification -----------------------------------------
# Every login path (login/verify, login/otp, social) rests on this.
#   firebase (default) - verifies real Firebase Phone Auth ID tokens. Needs
#                        FIREBASE_SERVICE_ACCOUNT below.
#   mock               - accepts a `kaya-mock-verifier:<phone>` token and
#                        nothing else.
#
# The mock is an AUTHENTICATION BYPASS: anyone who can reach a backend running
# it can mint a session for any account whose phone they know. The auth module
# refuses to boot with it under NODE_ENV=production, and every acceptance is
# logged at warn level. It exists because phone verification was the only
# external integration here without a keyless implementation, which left a
# fresh checkout unable to log in at all.
FIREBASE_VERIFIER=firebase

# --- Push notifications (M2) -----------------------------------------------
# FCM service-account JSON. Leave empty in dev to use the log provider.
FIREBASE_SERVICE_ACCOUNT=

# --- Offers (M2) -----------------------------------------------------------
# Reverse-auction bid lifetime in minutes.
OFFER_TTL_MIN=10

# --- Payments (M3) ---------------------------------------------------------
# Leave keys empty in dev to use the keyless mock gateway (full escrow flow works).
# Ghana (Paystack):
PAYSTACK_SECRET_KEY=
# Togo/Benin (Kkiapay):
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
# Hosted-checkout return URL.
PAYMENT_CALLBACK_URL=http://localhost:3000/payment-callback
# Driver withdrawal fee fraction (0.01 = 1%).
WITHDRAWAL_FEE_PCT=0.01

# --- Seed admin (used by prisma/seed.ts) -----------------------------------
ADMIN_EMAIL=admin@kaya.local
ADMIN_PHONE=+233200000000
ADMIN_PASSWORD=ChangeMe123!
